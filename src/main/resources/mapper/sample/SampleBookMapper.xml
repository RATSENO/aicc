<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.onestar.aicc.sample.mapper.SampleBookMapper">

    <resultMap id="bookResultMap" type="com.onestar.aicc.sample.domain.BookEntity">
        <id property="bookId" column="book_id"/>
        <result property="title" column="title"/>
        <result property="author" column="author"/>
        <result property="price" column="price"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="searchCondition">
        <where>
            <if test="condition.keyword != null and condition.keyword != ''">
                AND (title LIKE CONCAT('%', #{condition.keyword}, '%')
                     OR author LIKE CONCAT('%', #{condition.keyword}, '%'))
            </if>
            <if test="condition.status != null">
                AND status = #{condition.status}
            </if>
        </where>
    </sql>

    <select id="selectBooks" resultMap="bookResultMap">
        SELECT book_id, title, author, price, status, created_at
        FROM book
        <include refid="searchCondition"/>
        ORDER BY book_id
        LIMIT #{condition.size} OFFSET #{offset}
    </select>

    <select id="countBooks" resultType="long">
        SELECT COUNT(*)
        FROM book
        <include refid="searchCondition"/>
    </select>

    <select id="selectBookById" resultMap="bookResultMap">
        SELECT book_id, title, author, price, status, created_at
        FROM book
        WHERE book_id = #{bookId}
    </select>

    <insert id="insertBook" useGeneratedKeys="true" keyProperty="bookId" keyColumn="book_id">
        INSERT INTO book (title, author, price, status, created_at)
        VALUES (#{title}, #{author}, #{price}, #{status}, #{createdAt})
    </insert>

    <update id="updateBook">
        UPDATE book
        SET title = #{title},
            author = #{author},
            price = #{price},
            status = #{status}
        WHERE book_id = #{bookId}
    </update>

    <delete id="deleteBookById">
        DELETE FROM book WHERE book_id = #{bookId}
    </delete>

</mapper>
